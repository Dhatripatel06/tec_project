{
  "name": "aaje-su-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for \"Aaje Su?\" - hyperlocal city activity feed. Pilot city: Bhavnagar.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,sql}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/migrate.ts && tsx scripts/seed.ts -- --reset-demo",
    "occurrences:generate": "tsx scripts/generate-occurrences.ts",
    "listings:expire": "tsx scripts/expire-listings.ts",
    "admin:create": "tsx scripts/create-user.ts",
    "db:verify": "tsx scripts/verify-db.ts",
    "db:check": "tsx scripts/check-migrations.ts",
    "user:create": "tsx scripts/create-user.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.45.4",
    "next": "^15.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.14.0",
    "eslint-config-next": "^15.0.3",
    "pg": "^8.13.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "packageManager": "npm@11.4.2"
}
