# =============================================================================
# "Aaje Su?" backend — environment template
#
# Copy to .env.local (git-ignored) and fill in. NEVER commit real values.
#   cp .env.example .env.local
# =============================================================================

# --- Supabase: public (safe to ship to the browser) --------------------------
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Pilot city. Used when a request does not name a city.
NEXT_PUBLIC_DEFAULT_CITY_SLUG=bhavnagar

# --- Supabase: server-only (NEVER expose to the browser) ---------------------
# Dashboard → Project Settings → API → service_role.
# Bypasses RLS entirely. Server code only; no NEXT_PUBLIC_ prefix, ever.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection, used only by migrations and seeds.
# Dashboard → Project Settings → Database → Connection string → URI.
# Use the session-mode (port 5432) string; the transaction pooler on 6543
# cannot run DDL reliably.
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# --- Quick-add parser (PRD A5) ----------------------------------------------
# 'none' keeps everything on the deterministic ManualParser — no API calls,
# no key needed. Set a provider only when you want AI-assisted parsing.
AI_PARSER_PROVIDER=none
# AI_PARSER_API_KEY=
AI_PARSER_MODEL=claude-sonnet-5

# --- Push notifications (PRD F8 / A8) ---------------------------------------
# 'none' records campaigns in the database without delivering them.
PUSH_PROVIDER=none
# FCM_SERVER_KEY=

# --- Behaviour ---------------------------------------------------------------
# How far ahead recurring listings are materialised into occurrences.
OCCURRENCE_HORIZON_DAYS=120

# In-memory rate limiting on public endpoints. Disable only in tests.
RATE_LIMIT_ENABLED=true
